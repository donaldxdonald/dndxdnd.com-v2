{
  "name": "donaldxodnald.xyz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev",
    "build": "pnpm run gen:data && pnpm run build:only",
    "build:only": "next build --turbo",
    "gen:data": "pnpm run gen:rss && pnpm run gen:tracks",
    "gen:rss": "tsx ./scripts/rss.ts",
    "gen:tracks": "tsx ./scripts/tracks.ts",
    "format": "eslint \"**/*.{js,jsx,ts,tsx,css,scss}\"",
    "start": "next start",
    "lint": "pnpm run format",
    "prepare": "npx simple-git-hooks"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "engineStrict": true,
  "dependencies": {
    "@fontsource/jost": "^5.2.8",
    "@fontsource/noto-serif": "^5.2.9",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@vercel/analytics": "^1.6.1",
    "cmdk": "^1.1.1",
    "cnfast": "^0.0.8",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "feed": "^5.0.1",
    "fumadocs-core": "^16.4.8",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-ui": "^16.4.8",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.563.0",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^12.29.0",
    "next": "16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-wrap-balancer": "^1.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-mdx": "^3.1.1",
    "sass": "^1.97.3",
    "sharp": "^0.34.5",
    "strip-markdown": "^6.0.0",
    "to-vfile": "^8.0.0",
    "tsx": "^4.21.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile-matter": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dndxdnd/eslint-config": "^2.11.2",
    "@dotenvx/dotenvx": "^1.52.0",
    "@eslint-react/eslint-plugin": "^2.7.2",
    "@eslint/compat": "^2.0.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@shikijs/rehype": "^3.21.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/diacritics": "^1.3.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.1",
    "diacritics": "^1.3.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fdir": "^6.5.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
